{
  "window.title": "VC Müllheim - ${activeEditorShort}",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "editor.codeActionsOnSave": {
    "source.removeUnusedImports": "explicit"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": false,
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "chat.useNestedAgentsMdFiles": true,
  "chat.tools.terminal.autoApprove": {
    "/^(vp (run )?|vpr )(test|check(--fix)?|lint|verify(:all)?|cdk:synth(:all)?|deps-check)(\\s+[\\w./\\-:*=]+)*(\\s+2>&1)?(\\s*\\|\\s*(head|tail|cat|grep|wc)(\\s+[\\w./\\-*=]+)*)?$/": true,
    "/\\.agents\\/skills\\/sams-api\\/sams\\.ts/": true,
    "/^bun \\.agents\\/skills\\/lambda-logs\\/check-logs\\.ts .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^aws dynamodb (scan|query|get-item|describe-table|list-tables) .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^aws lambda (list-functions|get-function-configuration) .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^aws logs (describe-log-groups) .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^aws sts get-caller-identity .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^aws cloudformation (describe-stack-events) .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^vpr sams:codegen$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^vpr sams-api(?: --help| -h| [a-z][a-z-]*(?: [0-9a-fA-F-]{36})?(?: [a-z][a-z-]*)?(?: --query [a-zA-Z][\\w-]*=[^\\s|;&`$]+)*)?(?: 2>\\/dev\\/null)?(?: \\| jq(?: -[a-zA-Z]+)*(?: '[^']*')?)?$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "github-actions.workflows.pinned.workflows": [".github/workflows/cdk-deploy.yml"],
  "window.autoDetectColorScheme": true,
  "chat.mcp.serverSampling": {
    "vcmuellheim/.vscode/mcp.json: Sentry.io": {
      "allowedModels": ["copilot/auto"]
    }
  },
  "chat.hookFilesLocations": {
    ".agents/hooks": true
  }
}
