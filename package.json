{
  "name": "vcmuellheim.de",
  "version": "2.0.0",
  "private": true,
  "homepage": "https://vcmuellheim.de",
  "bugs": {
    "url": "https://github.com/terijaki/vcmuellheim/issues"
  },
  "author": {
    "name": "Björn Kohnen",
    "email": "bjoern@vcmuellheim.de"
  },
  "type": "module",
  "scripts": {
    "start": "node app/.output/server/index.mjs",
    "test": "vp test",
    "lint": "vp check",
    "check:fix": "vp check --fix",
    "db:seed": "bun ./scripts/db-seed.ts",
    "db:seed:sams": "bun ./scripts/data-trigger-syncs.ts",
    "sams:codegen": "bun ./codegen/sams/generate-client.ts",
    "verify": "vp check --fix && vp test",
    "cdk:deploy": "cdk deploy --require-approval=never",
    "cdk:deploy:all": "cdk deploy --all --require-approval=never",
    "cdk:deploy:prod": "CDK_ENVIRONMENT=prod cdk deploy --all",
    "cdk:synth:all": "cdk synth --all",
    "cdk:synth:prod": "CDK_ENVIRONMENT=prod cdk synth --all",
    "cdk:diff": "cdk diff",
    "cdk:diff:all": "cdk diff --all",
    "cdk:diff:prod": "CDK_ENVIRONMENT=prod cdk diff --all",
    "cdk:destroy": "CDK_DESTROY=true cdk destroy --require-approval=never",
    "cdk:destroy:all": "CDK_DESTROY=true cdk destroy --all --require-approval=never",
    "cdk:bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.0",
