{
  "name": "vcmuellheim.de",
  "version": "2.0.0",
  "private": true,
  "homepage": "https://vcmuellheim.de",
  "bugs": {
    "url": "https://github.com/terijaki/vcmuellheim/issues"
  },
  "author": {
    "name": "Björn Kohnen",
    "email": "bjoern@vcmuellheim.de"
  },
  "type": "module",
  "scripts": {
    "start": "node app/.output/server/index.mjs",
    "dev": "varlock run -- vp dev",
    "test": "vp test",
    "test:e2e": "playwright test",
    "lint": "vp check",
    "check:fix": "vp check --fix",
    "db:seed": "bun ./scripts/db-seed.ts",
    "db:seed:user": "bun ./scripts/db-seed-user.ts",
    "db:seed:sams": "bun ./scripts/seed-sams-provider-events.ts",
    "migrate:off-electrodb": "bun ./scripts/migrate-off-electrodb.ts",
    "verify": "vp check --fix && vp test",
    "cdk:deploy": "cdk deploy --require-approval=never",
    "cdk:deploy:all": "cdk deploy --all --require-approval=never --concurrency 4",
    "cdk:deploy:prod": "CDK_ENVIRONMENT=prod cdk deploy --all --concurrency 4",
    "cdk:deploy:buntime": "CDK_DEPLOY_BUNTIME=true cdk deploy BunTimeStack-Dev --require-approval=never",
    "cdk:deploy:buntime:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_BUNTIME=true cdk deploy BunTimeStack-Prod --require-approval=never",
    "cdk:synth:all": "cdk synth --all",
    "cdk:synth:prod": "CDK_ENVIRONMENT=prod cdk synth --all",
    "cdk:synth:buntime": "CDK_DEPLOY_BUNTIME=true cdk synth BunTimeStack-Dev",
    "cdk:synth:buntime:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_BUNTIME=true cdk synth BunTimeStack-Prod",
    "cdk:diff": "cdk diff",
    "cdk:diff:all": "cdk diff --all",
    "cdk:diff:prod": "CDK_ENVIRONMENT=prod cdk diff --all",
    "cdk:diff:buntime": "CDK_DEPLOY_BUNTIME=true cdk diff BunTimeStack-Dev",
    "cdk:diff:buntime:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_BUNTIME=true cdk diff BunTimeStack-Prod",
    "cdk:destroy": "CDK_DESTROY=true cdk destroy --require-approval=never",
    "cdk:destroy:all": "CDK_DESTROY=true cdk destroy --all --require-approval=never --concurrency 4",
    "cdk:bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
