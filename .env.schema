# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-central-1, namePrefix="/vcm/")
# ----------

# -- AWS CDK configuration --
# @public @type=enum(dev,prod)
CDK_ENVIRONMENT=dev
# @sensitive @type=email(normalize=true) @optional
CDK_BUDGET_ALERT_EMAIL=awsParam("cdk-reporting-email")
# @sensitive @type=email(normalize=true) @optional
CDK_MONITORING_ALERT_EMAIL=awsParam("cdk-reporting-email")

# -- Better Auth configuration --
# @sensitive @type=string @required
BETTER_AUTH_SECRET=awsParam("better-auth-secret")

#-- SAMS API credentials --
# @sensitive @type=string @required
SAMS_API_KEY=awsParam("sams-api-key")

# -- Behold Instagram feed --
# @sensitive @type=string @required
BEHOLD_FEED_URL=awsParam("behold-feed-url")

# -- Mastodon API credentials --
# @sensitive @type=string @docs("Mastodon access token for API authentication", https://freiburg.social/settings/applications)
MASTODON_ACCESS_TOKEN=awsParam("mastodon/access-token")
# @sensitive @type=string
MASTODON_CLIENT_KEY=awsParam("mastodon/client-key")
# @sensitive @type=string
MASTODON_CLIENT_SECRET=awsParam("mastodon/client-secret")

# --- Sentry configuration ---
# @sensitive @type=string @required
SENTRY_AUTH_TOKEN=awsParam("sentry-auth-token")
# @type=enum(dev,prod)
SENTRY_ENVIRONMENT=dev
